{
  "name": "@ui/motion",
  "version": "0.1.0",
  "description": "Motion components: animate, reveal, stagger, and scroll or hover parallax Web Components.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./css/motion.css"
  },
  "files": [
    "dist",
    "css"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ui/core": "workspace:*",
    "@ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "happy-dom": "15.11.6"
  }
}
