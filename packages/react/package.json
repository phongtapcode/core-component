{
  "name": "@element-works/react",
  "version": "0.1.1",
  "type": "module",
  "description": "React and Next.js adapters for Element Works Web Components.",
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md"],
  "sideEffects": ["./dist/styles.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-works/components": "workspace:*",
    "@element-works/motion": "workspace:*",
    "@element-works/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "15.11.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
